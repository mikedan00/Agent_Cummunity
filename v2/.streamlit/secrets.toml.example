# Copy to .streamlit/secrets.toml for local runs (that file is git-ignored).
# On Streamlit Community Cloud, paste these lines into App settings → Secrets.

# Required: Hugging Face token with "Make calls to Inference Providers" permission
# (plus repo write permission if HF_DATASET_REPO is set)
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Database. Supabase: Project → Connect → "Session pooler" connection string.
# Leave out to use a local SQLite file (community.db) — fine for development only.
# DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optional: Telegram bot token from @BotFather. Leave out to turn the bot off.
# TELEGRAM_BOT_TOKEN = "123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: Tavily web search key. Without it the agents search DuckDuckGo.
# TAVILY_API_KEY = "tvly-xxxxxxxxxxxxxxxx"

# Optional: models shown in the sidebar (first one is the default, also used by Telegram).
# "model:provider" pins a provider; no suffix lets Hugging Face choose.
# HF_MODELS = [
#   "google/gemma-4-26B-A4B-it:deepinfra",
#   "Qwen/Qwen3.6-27B",
#   "Qwen/Qwen2.5-7B-Instruct",
# ]
