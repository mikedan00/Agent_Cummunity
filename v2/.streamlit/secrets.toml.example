# Copy to .streamlit/secrets.toml for local runs (that file is git-ignored).
# On HF Spaces, add each value as a Space secret instead (they arrive as environment
# variables); the [auth] section is generated from the AUTH_* secrets by write_secrets.py.

# Required: Hugging Face token with "Make calls to Inference Providers" permission
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Database. Supabase: Project → Connect → "Session pooler" connection string.
# Leave out to use a local SQLite file (community.db) — fine for development only.
# DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Admins (comma-separated Google account emails): see reports, hide content, ban users.
# ADMIN_EMAILS = "you@gmail.com"

# Optional: Telegram bot token from @BotFather. Leave out to turn the bot off.
# TELEGRAM_BOT_TOKEN = "123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: your Telegram chat id, told when the daily AI cap is reached.
# ADMIN_TELEGRAM_CHAT_ID = "123456789"

# Optional: Tavily web search key. Without it the agents search DuckDuckGo.
# TAVILY_API_KEY = "tvly-xxxxxxxxxxxxxxxx"

# Optional: models shown in the sidebar (first one is the default, also used by Telegram).
# HF_MODELS = ["google/gemma-4-26B-A4B-it:deepinfra", "Qwen/Qwen3.6-27B"]

# Optional: usage limits (defaults shown).
# LIMIT_AI_PER_DAY = 30
# LIMIT_POSTS_PER_DAY = 5
# LIMIT_AGENT_CALLS_PER_HOUR = 20
# LIMIT_MESSAGES_PER_MIN = 20
# GLOBAL_AI_PER_DAY = 2000

# Google login (st.login). Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application); add redirect_uri as an authorized redirect URI.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "a-long-random-string"
# [auth.google]
# client_id = "xxxx.apps.googleusercontent.com"
# client_secret = "xxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
